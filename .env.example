# ============================================================
# AI 智能客服系统 v3 - 环境变量（复制为 .env 后填写）
# 注意：LLM 配置仅作为"首次启动默认值"，之后以管理端「设置」页
#       （SQLite settings 表）为准，在线修改即时生效。
# ============================================================

# --- 服务 ---
HOST=0.0.0.0
PORT=8000
DEBUG=false

# --- 认证 ---
JWT_SECRET=change-me-to-a-random-secret

# --- LLM（OpenAI 兼容接口：硅基流动 / OpenAI / DeepSeek 官方均可）---
LLM_BASE_URL=https://api.siliconflow.cn/v1
LLM_API_KEY=
LLM_CHAT_MODEL=deepseek-ai/DeepSeek-V4-Flash
# 意图分类用的小模型（留空则复用 CHAT_MODEL；建议填快而便宜的小模型）
LLM_INTENT_MODEL=Qwen/Qwen2.5-7B-Instruct
LLM_EMBEDDING_MODEL=BAAI/bge-m3

# --- RAG ---
CHUNK_SIZE=512
CHUNK_OVERLAP=64
RETRIEVAL_TOP_K=4
RETRIEVAL_MIN_SCORE=0.35

# --- 上传 ---
MAX_UPLOAD_SIZE_MB=20
